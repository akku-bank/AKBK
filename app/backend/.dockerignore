# Gradle cache & build output — 가장 크고 불필요한 디렉토리
.gradle/
build/

# Gradle wrapper jar는 빌드에 필요하므로 예외
!gradle/wrapper/gradle-wrapper.jar

# IDE 설정
.idea/
*.iws
*.iml
*.ipr
out/
.vscode/
.classpath
.project
.settings/
.springBeans
.sts4-cache/
.apt_generated/
.factorypath/

# Windows 전용 (Linux 컨테이너 불필요)
gradlew.bat

# 문서
*.md
HELP.md

# 환경변수 파일 (보안)
.env
.env.*

# Git
.git/
.gitignore

# 테스트 리포트 (build/ 아래 있지만 명시적 제외)
**/test-results/
**/reports/
