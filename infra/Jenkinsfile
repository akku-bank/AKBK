pipeline {
    agent any

    environment {
        MM_WEBHOOK = credentials('mattermost-webhook-url')
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout already handled by Pipeline SCM'
            }
        }

        stage('Prepare Metadata') {
            steps {
                script {
                    env.BUILT_BRANCH   = env.gitlabBranch ?: env.BRANCH_NAME ?: "unknown"
                    env.SOURCE_BRANCH  = env.gitlabSourceBranch ?: ""
                    env.TARGET_BRANCH  = env.gitlabTargetBranch ?: ""
                    env.TRIGGER_USER   = env.gitlabUserName ?: "unknown"

                    def branchForTeam = env.SOURCE_BRANCH?.trim() ? env.SOURCE_BRANCH : env.BUILT_BRANCH
                    def parts = branchForTeam.tokenize('/')
                    def teamCode = parts.size() >= 2 ? parts[1].toLowerCase() : "unknown"

                    def teamMap = [
                        "ai": "AI",
                        "de": "DATA",
                        "be": "BACKEND",
                        "fe": "FRONTEND",
                        "infra": "INFRA"
                    ]

                    env.TARGET_TEAM = teamMap.get(teamCode, "COMMON_OPS")

                    env.BRANCH_DISPLAY = (env.SOURCE_BRANCH?.trim() && env.TARGET_BRANCH?.trim())
                        ? "${env.SOURCE_BRANCH} → ${env.TARGET_BRANCH}"
                        : env.BUILT_BRANCH

                    echo "TEAM=${env.TARGET_TEAM}"
                    echo "BRANCH=${env.BRANCH_DISPLAY}"
                    echo "USER=${env.TRIGGER_USER}"
                }
            }
        }

        stage('Infrastructure Check') {
            steps {
                sh '[ -f infra/docker-compose.yml ] && echo "Docker config found" || echo "Skip check"'
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    echo "🔥 실패 테스트 실행 중..."
                    sh 'exit 1'   // 🔥 강제 실패
                }
            }
        }
    }

    post {
        success {
            sh """
            curl -X POST -H 'Content-Type: application/json' \
            -d '{
              "text":"✅ **[${env.TARGET_TEAM}] Jenkins 빌드 성공**\\n- 프로젝트: ${env.JOB_NAME}\\n- 빌드 번호: #${env.BUILD_NUMBER}\\n- 브랜치: ${env.BRANCH_DISPLAY}\\n- 요청자: ${env.TRIGGER_USER}\\n- 확인: ${env.BUILD_URL}"
            }' \
            ${MM_WEBHOOK}
            """
        }

        failure {
            script {
                def logFile = "${env.WORKSPACE}/extracted_log.txt"

                sh """
                if [ -f /var/jenkins_home/jobs/${env.JOB_NAME}/builds/${env.BUILD_NUMBER}/log ]; then
                  tail -n 50 /var/jenkins_home/jobs/${env.JOB_NAME}/builds/${env.BUILD_NUMBER}/log > ${logFile}
                else
                  echo "No Jenkins raw log file found" > ${logFile}
                fi
                """

                // 로그 분석
                sh "python3 infra/jenkins/analyze_log.py ${logFile} ${env.JOB_NAME} ${env.BUILD_NUMBER} ${env.BUILD_URL}"

                // 🔥 Python 결과 그대로 전송
                sh """
                curl -X POST -H 'Content-Type: application/json' \
                -d @${env.WORKSPACE}/mattermost_payload.json \
                ${MM_WEBHOOK}
                """
            }
        }
    }
}